{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=traveltrip_db;Username=postgres;Password=YOUR_DB_PASSWORD_HERE"
  },
  "Jwt": {
    "Secret": "YOUR_SECURE_JWT_SECRET_KEY_HERE",
    "Issuer": "TravelTripApi",
    "Audience": "TravelTripClient",
    "ExpireMinutes": "1440"
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE"
  },
  "HuggingFace": {
    "ApiKey": "YOUR_HUGGINGFACE_API_KEY_HERE"
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": "587",
      "Username": "your-email@gmail.com",
      "Password": "your-app-password"
    },
    "From": "noreply@traveltrip.com",
    "FromName": "TravelTrip"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "RagInitialization": {
    "Enabled": true,
    "BatchSize": 10
  }
}